{
  "name": "open-energy-studio",
  "version": "0.1.7-alpha",
  "description": "Energy performance workspace with an experimental NTA 8800 input audit",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bump": "node scripts/bump-version.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "wasm-pack build crates/nta8800-wasm --target web --release --out-dir ../../src/kernel-wasm --out-name nta8800 && node -e \"require('fs').rmSync('src/kernel-wasm/.gitignore',{force:true})\""
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "fflate": "^0.8.3",
    "i18next": "^25.8.13",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@tauri-apps/api": "2.10.1"
  }
}
